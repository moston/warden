        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "span_name": "Span",
              "Value #rate": "rate (req/s)",
              "Value #p95": "p95 (s)"
            }
          }
        }
      ]
    },
