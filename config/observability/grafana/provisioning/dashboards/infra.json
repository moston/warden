            "uid": "prometheus"
          },
          "expr": "sum(rate(redis_keyspace_hits_total{env_name=~\"$env_name\",service=~\"$service\"}[$__rate_interval])) / clamp_min(sum(rate(redis_keyspace_hits_total{env_name=~\"$env_name\",service=~\"$service\"}[$__rate_interval]))+sum(rate(redis_keyspace_misses_total{env_name=~\"$env_name\",service=~\"$service\"}[$__rate_interval])),1) * 100"
