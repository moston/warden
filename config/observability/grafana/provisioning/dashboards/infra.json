  "templating": {
    "list": [
      {
        "name": "env_name",
        "label": "env_name",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(up{job=\"warden-containers\"}, env_name)",
        "query": {
          "qryType": 1,
          "query": "label_values(up{job=\"warden-containers\"}, env_name)",
          "refId": "StandardVariableQuery"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "service",
        "label": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(up{job=\"warden-containers\"}, service)",
        "query": {
          "qryType": 1,
          "query": "label_values(up{job=\"warden-containers\"}, service)",
          "refId": "StandardVariableQuery"
