      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(10, sum by (span_name) (rate(traces_spanmetrics_calls_total{service_name=~\"$service\",span_kind=\"SPAN_KIND_SERVER\",span_name!~\".*/(static|media)/.*\"}[$__rate_interval])))",
